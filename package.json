{
    "name": "opencode-gitlab-pipeline",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": "./dist/index.js",
    "files": [
        "dist/index.js",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/navitronic/opencode-gitlab-pipeline.git"
    },
    "homepage": "https://github.com/navitronic/opencode-gitlab-pipeline#readme",
    "scripts": {
        "test": "bun test tests",
        "typecheck": "tsc --noEmit",
        "build": "bun build src/index.ts --target=bun --packages=external --outdir=dist",
        "format": "prettier --write package.json tsconfig.json \"src/**/*.ts\" \"tests/**/*.ts\" README.md",
        "lint": "bun run typecheck && prettier --check package.json tsconfig.json \"src/**/*.ts\" \"tests/**/*.ts\" README.md"
    },
    "dependencies": {
        "@opencode-ai/plugin": "1.18.30"
    },
    "devDependencies": {
        "@types/bun": "1.3.10",
        "typescript": "7.0.2",
        "prettier": "3.9.6"
    }
}
